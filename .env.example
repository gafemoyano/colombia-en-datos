# Development and production both use Turso/libSQL for metadata.
# Create a dev database with the Turso CLI, then fill these values from `turso db show` / `turso db tokens create`.
DATABASE_URL=libsql://your-dev-db.turso.io
TURSO_AUTH_TOKEN=your-dev-token

# Opt-in explorer request logs, Server-Timing headers and browser performance marks.
# Leave disabled outside a measurement window. See docs/performance.md.
PERFORMANCE_TRACING=0

# Canonical DuckDB observation store path.
DUCKDB_PATH=./data

# Admin Basic Auth for /admin and protected ingest APIs.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin


# Preview deploys use a separate Turso database.
PREVIEW_DATABASE_URL=libsql://your-preview-db.turso.io
PREVIEW_DATABASE_TOKEN=your-preview-token
